PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/conciliacao
ENGINE_URL=http://localhost:8000
RECONCILIATION_CRON=0 6 * * *
DATE_TOLERANCE_DAYS=2

SICREDI_BASE_URL=https://mtls-api-parceiro.sicredi.com.br
SICREDI_SCOPE=contacorrente.extratos.consultar contacorrente.saldo.consultar
SICREDI_PAGE_SIZE=100
SICREDI_PIX_BASE_URL=https://api-pix.sicredi.com.br
SICREDI_PIX_SANDBOX_BASE_URL=https://api-pix-h.sicredi.com.br
SICREDI_PIX_SCOPE=pix.read

AGROTIS_BASE_URL=https://api.agrotis.com.br
AGROTIS_TOKEN_URL=https://api.agrotis.com.br/oauth/token

# api: "contacorrente" (padrão, extrato + saldo) ou "pix" (somente Pix recebidos); sandbox: true usa homologação
SICREDI_IDEAL_ARMAZEM={"api":"contacorrente","clientId":"","clientSecret":"","certPath":"/app/secrets/idealarmazem-kennedy.crt","keyPath":"/app/secrets/idealarmazem-kennedy.key"}
SICREDI_CONTA_PRINCIPAL={"clientId":"","clientSecret":"","certPath":"/app/secrets/validapix-sicredi.crt","keyPath":"/app/secrets/validapix-sicredi.key"}
AGROTIS_CONTA_PRINCIPAL={"clientId":"","clientSecret":""}
